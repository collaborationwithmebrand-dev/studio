
{
  "entities": {
    "Product": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Product",
      "type": "object",
      "description": "Represents an item available for sale in the Bounsi Bazaar store.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "unit": { "type": "string", "description": "Flexible unit string, e.g., '500 gm', '1 Liter', 'XL'." },
        "section": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string", "format": "uri" },
        "imageUrl2": { "type": "string", "format": "uri", "description": "Secondary product image for the carousel." },
        "description": { "type": "string" },
        "deliveryMode": { "type": "string", "enum": ["instant", "standard"], "description": "Delivery speed: instant (25m) or standard (2d)" },
        "isCodAvailable": { "type": "boolean" },
        "isUpiAvailable": { "type": "boolean" },
        "isPinned": { "type": "boolean" },
        "isOutOfStock": { "type": "boolean", "description": "True if the product is currently unavailable." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "price", "unit", "section", "imageUrl", "createdAt"]
    },
    "UserProfile": {
      "title": "User Profile",
      "type": "object",
      "properties": {
        "phoneNumber": { "type": "string" },
        "email": { "type": "string" }
      }
    },
    "StoreSetting": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "StoreSetting",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "manualRevenue": { "type": "number", "description": "Admin-defined total earnings display." },
        "estimatedDeliveryTime": { "type": "string", "description": "e.g., '17 Minutes'" },
        "freeDeliveryThreshold": { "type": "number" },
        "freeDeliveryMessage": { "type": "string" },
        "upiId": { "type": "string" },
        "upiQrUrl": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "helpLineNumber": { "type": "string" },
        "isOrderingEnabled": { "type": "boolean", "description": "Admin toggle to enable/disable all ordering sitewide." },
        "lastUpdated": { "type": "string", "format": "date-time" }
      }
    },
    "Order": {
      "title": "Order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "recipientPhone": { "type": "string" },
        "senderPhone": { "type": "string" },
        "deliveryAddress": { "type": "string" },
        "isForSomeoneElse": { "type": "boolean" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "delivered", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Ad": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Advertisement",
      "type": "object",
      "description": "Represents a promotional advertisement that features a specific product.",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string", "description": "The ID of the product being featured." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "productId", "createdAt"]
    },
    "admin_role": {
      "title": "Admin Role",
      "type": "object",
      "properties": {
        "assignedAt": { "type": "string", "format": "date-time" }
      }
    },
    "public_theme_setting": {
      "title": "Public Theme Setting",
      "type": "object",
      "properties": {
        "activeThemeName": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["anonymous"]
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/backend/entities/Product" },
      "description": "Public product catalog."
    },
    "/ads/{adId}": {
      "schema": { "$ref": "#/backend/entities/Ad" },
      "description": "Promotional ads for the storefront."
    },
    "/admin_roles/{adminUid}": {
      "schema": { "$ref": "#/backend/entities/admin_role" },
      "description": "Markers for users with admin access."
    },
    "/storeSettings/mainSettings": {
      "schema": { "$ref": "#/backend/entities/StoreSetting" },
      "description": "Sensitive administrative settings."
    },
    "/publicDisplaySettings/theme": {
      "schema": { "$ref": "#/backend/entities/public_theme_setting" },
      "description": "Publicly visible UI configuration."
    },
    "/userProfiles/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "User specific data like phone number."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/backend/entities/Order" },
      "description": "Tracked customer orders."
    }
  }
}
